+#if CONFIG_KESHI_VOICE_MODE
+void Application::MaintainControlChannel() {
+    // Runs in the main task once per second. Keeps the WebSocket open while idle so the
+    // server can push "notify" messages (task finished, announcements from chat apps).
+    if (!protocol_ || GetDeviceState() != kDeviceStateIdle) {
+        return;
+    }
+    if (protocol_->IsAudioChannelOpened()) {
+        reconnect_backoff_s_ = 2;
+        return;
+    }
+    int64_t now = esp_timer_get_time();
+    if (now < next_reconnect_us_) {
+        return;
+    }
+    ESP_LOGI(TAG, "Keep-alive: reconnecting to server");
+    quiet_reconnect_ = true;
+    bool ok = protocol_->OpenAudioChannel();
+    quiet_reconnect_ = false;
+    if (ok) {
+        reconnect_backoff_s_ = 2;
+    } else {
+        reconnect_backoff_s_ = std::min(reconnect_backoff_s_ * 2, 60);
+    }
+    next_reconnect_us_ = esp_timer_get_time() + (int64_t)reconnect_backoff_s_ * 1000000;
+}
+#endif
