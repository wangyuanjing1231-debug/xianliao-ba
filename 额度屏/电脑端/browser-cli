#!/usr/bin/env node

import { Client } from '/usr/lib/node_modules/@modelcontextprotocol/sdk/dist/esm/client/index.js';
import { StreamableHTTPClientTransport } from '/usr/lib/node_modules/@modelcontextprotocol/sdk/dist/esm/client/streamableHttp.js';
import fs from 'fs';
import path from 'path';

const MCP_URL = process.env.BROWSER_MCP_URL || 'http://127.0.0.1:8931/mcp';

async function createConnectedClient() {
  const transport = new StreamableHTTPClientTransport(new URL(MCP_URL));
  const client = new Client({ name: 'browser-cli', version: '1.0.0' }, { capabilities: {} });
  await client.connect(transport);
  return { client, transport };
}

function showHelp() {
  console.log(`
browser-cli: YJW 本地浏览器 MCP 命令行小工具

用法:
  browser-cli tools                      列出服务提供的所有可用工具
  browser-cli open <url>                 打开指定网址（调用 browser_navigate）
  browser-cli screenshot [保存路径.png]    对当前网页截图并保存（默认当前目录 screenshot.png）
  browser-cli call <工具名> [JSON参数]     通用工具调用，支持调用任意 MCP 工具
  browser-cli --help                     显示本帮助

示例:
  browser-cli tools
  browser-cli open https://github.com
  browser-cli screenshot ./github.png
  browser-cli call browser_snapshot '{}'
  browser-cli call browser_close '{}'
`);
}

async function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  if (!command || command === '--help' || command === '-h' || command === 'help') {
    showHelp();
    return;
  }

  try {
    if (command === 'tools') {
      const { client } = await createConnectedClient();
      const res = await client.listTools();
      console.log(`连接成功 (${MCP_URL})，共有 ${res.tools.length} 个工具可用:\n`);
      for (const t of res.tools) {
        const desc = (t.description || '').split('\n')[0];
        console.log(`  - ${t.name.padEnd(28)} : ${desc}`);
      }
      await client.close();
      return;
    }

    if (command === 'open' || command === 'navigate' || command === 'goto') {
      const url = args[1];
      if (!url) {
        console.error('错误: 请提供要打开的网址。例如: browser-cli open https://github.com');
        process.exit(1);
      }
      const { client } = await createConnectedClient();
      console.log(`正在打开网址: ${url} ...`);
      const res = await client.callTool({
        name: 'browser_navigate',
        arguments: { url }
      });
      console.log('打开完成！');
      for (const item of res.content || []) {
        if (item.type === 'text') {
          console.log(item.text);
        }
      }
      await client.close();
      return;
    }

    if (command === 'screenshot' || command === 'snap') {
      const outPath = path.resolve(process.cwd(), args[1] || 'screenshot.png');
      const { client } = await createConnectedClient();
      console.log(`正在截图当前页面，准备保存到: ${outPath} ...`);
      const res = await client.callTool({
        name: 'browser_take_screenshot',
        arguments: { scale: 'css' }
      });
      let saved = false;
      for (const item of res.content || []) {
        if (item.type === 'image' && item.data) {
          fs.writeFileSync(outPath, Buffer.from(item.data, 'base64'));
          saved = true;
          console.log(`截图已成功保存到: ${outPath}`);
        } else if (item.type === 'text') {
          console.log(item.text);
        }
      }
      if (!saved) {
        console.log('提示: 未从返回中提取到图片原始数据，请检查工具输出。');
      }
      await client.close();
      return;
    }

    if (command === 'call') {
      const toolName = args[1];
      if (!toolName) {
        console.error('错误: 请指定要调用的工具名。例如: browser-cli call browser_close "{}"');
        process.exit(1);
      }
      let toolArgs = {};
      if (args[2]) {
        try {
          toolArgs = JSON.parse(args[2]);
        } catch (e) {
          console.error('错误: 参数必须是有效的 JSON 字符串，例如 \'{ "url": "https://github.com" }\'');
          process.exit(1);
        }
      }
      const { client } = await createConnectedClient();
      console.log(`正在调用工具 ${toolName} ...`);
      const res = await client.callTool({
        name: toolName,
        arguments: toolArgs
      });
      console.log('调用返回:');
      for (const item of res.content || []) {
        if (item.type === 'text') {
          console.log(item.text);
        } else if (item.type === 'image') {
          console.log(`[Image mimeType=${item.mimeType} length=${item.data?.length}]`);
        }
      }
      await client.close();
      return;
    }

    console.error(`未知命令: ${command}`);
    showHelp();
    process.exit(1);

  } catch (err) {
    console.error('执行失败:', err.message || err);
    process.exit(1);
  }
}

main();
